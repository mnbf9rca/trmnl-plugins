<div class="layout layout--col layout--top layout--stretch-x">
  <div class="title_bar">
    <img class="image image-dither" src="{{ train_icon }}" />
    <span class="title title--small lg:title--base lg:portrait:title--small">{{ station | default: "Train departures" }}{% if filter_station %} via {{ filter_station }}{% endif %}</span>
  </div>

  {% render "board", station: station, api_error: api_error, services: services, messages: messages, table_class: "table--xsmall lg:table--small lg:portrait:table--xsmall", head_class: "title--small lg:title--base lg:portrait:title--small", cell_class: "label lg:label--large lg:portrait:label--base", platform: false %}
</div>
