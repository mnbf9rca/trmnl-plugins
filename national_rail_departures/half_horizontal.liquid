<div class="layout layout--col layout--top layout--stretch-x gap--none">
  <div class="title_bar">
    <img class="image image-dither" src="{{ train_icon }}" />
    <span class="title lg:title--large lg:portrait:title--base">{{ station | default: "Train departures" }}{% if filter_station %} via {{ filter_station }}{% endif %}</span>
    <span class="instance">National Rail</span>
  </div>

  {% render "board", station: station, api_error: api_error, services: services, messages: messages, table_class: "table--small lg:table--base lg:portrait:table--small", head_class: "title--small lg:title--base lg:portrait:title--small", cell_class: "value value--small lg:value--base lg:portrait:value--small", platform: true %}
</div>
