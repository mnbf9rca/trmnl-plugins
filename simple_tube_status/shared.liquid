{% assign lines = data %}
{%- comment -%}ponytail: TRMNL may hand a boolean field over as true or "true"; accept both{%- endcomment -%}
{% assign show_reason = false %}{% if show_disruptions == true or show_disruptions == "true" %}{% assign show_reason = true %}{% endif %}
{% assign api_error = message | default: data.message %}
{% assign roundel = "data:image/svg+xml;base64," %}

{% template board %}
{%- comment -%}ponytail: severity_rank is our own worst-first order; a code missing from it sorts last{%- endcomment -%}
{%- assign severity_rank = "1,2,16,3,4,5,11,6,8,7,15,14,9,12,13,17,0,19" | split: "," -%}
{% assign n_lines = lines | size %}
{% if n_lines == 0 %}
<span class="title {{ head_class }} px--1">Could not fetch TfL status</span>
{% if api_error %}<span class="{{ cell_class }} px--1">{{ api_error | escape }}</span>{% endif %}
{% else %}
{% assign disrupted = 0 %}
{%- for line in lines -%}
{%- assign line_disrupted = false -%}
{%- for status in line.lineStatuses -%}
{%- if status.statusSeverity != 10 and status.statusSeverity != 18 and status.statusSeverity != 20 -%}
{%- assign line_disrupted = true -%}
{%- endif -%}
{%- endfor -%}
{%- if line_disrupted -%}
{%- assign disrupted = disrupted | plus: 1 -%}
{%- endif -%}
{%- endfor -%}
{% if disrupted == 0 %}
<div class="flex flex--center-x flex--center-y stretch-y">
  <span class="value value--large lg:value--xlarge lg:portrait:value--large">Good service on all lines</span>
</div>
{% else %}
{% assign show_table = false %}
{% if disrupted <= max_rows_lg %}{% assign show_table = true %}{% endif %}
{% assign show_compact = false %}
{% if disrupted > max_rows %}{% assign show_compact = true %}{% endif %}
{% assign both = false %}
{% if show_table and show_compact %}{% assign both = true %}{% endif %}
{%- comment -%}ponytail: with reasons off, a row is one line, so below max_with_reason (a cap sized for three-line rows) the name can go up two sizes safely{%- endcomment -%}
{% assign name_class = cell_class %}
{% if show_reason == false and big_class and disrupted <= max_with_reason %}{% assign name_class = big_class %}{% endif %}
{% if show_table %}
{% capture rows %}
{% for line in lines %}
{%- assign best_rank = 1000 -%}
{%- assign best_status = nil -%}
{%- for status in line.lineStatuses -%}
{%- if status.statusSeverity != 10 and status.statusSeverity != 18 and status.statusSeverity != 20 -%}
{%- assign this_rank = 99 -%}
{%- assign sev_str = status.statusSeverity | append: "" -%}
{%- for code in severity_rank -%}
{%- if sev_str == code -%}{%- assign this_rank = forloop.index0 -%}{%- endif -%}
{%- endfor -%}
{%- if this_rank < best_rank -%}
{%- assign best_status = status -%}
{%- assign best_rank = this_rank -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{% if best_rank < 1000 %}
    <tr>
      {% if show_reason and disrupted <= max_with_reason_lg %}
      {%- comment -%}ponytail: drops everything before the first ": "; TfL always prefixes the line name{%- endcomment -%}
      {% assign reason_parts = best_status.reason | strip | split: ": " %}
      {% if reason_parts.size > 1 %}{% assign reason = reason_parts | slice: 1, 99 | join: ": " %}{% else %}{% assign reason = reason_parts | first %}{% endif %}
      {% if disrupted <= max_with_reason %}{% assign reason_class = "label lg:label--large lg:portrait:label--base block" %}{% else %}{% assign reason_class = "label lg:label--large lg:portrait:label--base hidden lg:visible" %}{% endif %}
      <td class="pl--1"><span class="{{ cell_class }}">{{ line.name | escape }}</span><span class="{{ reason_class }}" data-clamp="2">{{ reason | escape }}</span></td>
      {% else %}
      <td class="pl--1"><span class="{{ name_class }}">{{ line.name | escape }}</span></td>
      {% endif %}
      <td class="text--right pr--1"><span class="label label--inverted lg:label--large lg:portrait:label--base">{{ best_status.statusSeverityDescription | escape }}</span></td>
    </tr>
{% endif %}
{% endfor %}
{% endcapture %}
{% endif %}
{% if show_compact %}
{% assign half = disrupted | plus: 1 | divided_by: 2 %}
{% assign seen = 0 %}
{% capture col1 %}{% endcapture %}
{% capture col2 %}{% endcapture %}
{%- for line in lines -%}
{%- assign best_rank = 1000 -%}
{%- assign best_status = nil -%}
{%- for status in line.lineStatuses -%}
{%- if status.statusSeverity != 10 and status.statusSeverity != 18 and status.statusSeverity != 20 -%}
{%- assign this_rank = 99 -%}
{%- assign sev_str = status.statusSeverity | append: "" -%}
{%- for code in severity_rank -%}
{%- if sev_str == code -%}{%- assign this_rank = forloop.index0 -%}{%- endif -%}
{%- endfor -%}
{%- if this_rank < best_rank -%}
{%- assign best_status = status -%}
{%- assign best_rank = this_rank -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- if best_rank < 1000 -%}
{%- assign short_name = line.name | replace: "Hammersmith & City", "H&C" | replace: "Waterloo & City", "W&C" -%}
{%- capture row -%}<tr><td class="pl--1"><span class="{{ cell_class }}">{{ short_name | escape }}</span></td><td class="text--right pr--1"><span class="label label--inverted lg:label--large lg:portrait:label--base">{{ best_status.statusSeverityDescription | escape }}</span></td></tr>
{%- endcapture -%}
{%- assign seen = seen | plus: 1 -%}
{%- if seen <= half -%}
{%- assign col1 = col1 | append: row -%}
{%- else -%}
{%- assign col2 = col2 | append: row -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{% endif %}
<div class="grow w--full">
{% if show_table %}
{% if both %}<div class="hidden lg:visible">{% endif %}
<table class="table {{ table_class }}">
  <thead>
    <tr>
      <th class="pl--1"><span class="title {{ head_class }}">Line</span></th>
      <th class="text--right pr--1"><span class="title {{ head_class }}">Status</span></th>
    </tr>
  </thead>
  <tbody>
{{ rows }}
  </tbody>
</table>
{% if both %}</div>{% endif %}
{% endif %}
{% if show_compact %}
{% if both %}<div class="lg:hidden">{% endif %}
<div class="columns">
  <div class="column">
    <table class="table {{ table_class }}"><tbody>
{{ col1 }}
    </tbody></table>
  </div>
  <div class="column">
    <table class="table {{ table_class }}"><tbody>
{{ col2 }}
    </tbody></table>
  </div>
</div>
{% if both %}</div>{% endif %}
{% endif %}
</div>
<span class="{{ cell_class }} px--1">Good service on all other lines</span>
{% endif %}
{% endif %}
{% endtemplate %}
