<style>
  /* Sized by flexbox to the space above the title bar, so the table row limiter measures the right height. */
  .board { flex: 1 1 0; min-height: 0; width: 100%; }
</style>
{% assign lines = data %}
{% assign api_error = message | default: data.message %}
{% assign roundel = "data:image/svg+xml;base64," %}

{% template board %}
{%- comment -%}ponytail: severity_rank is our own worst-first order; a code missing from it sorts last{%- endcomment -%}
{%- assign severity_rank = "1,2,16,3,4,5,11,6,8,7,15,14,9,12,13,17,0,19" | split: "," -%}
{% assign n_lines = lines | size %}
{% if n_lines == 0 %}
<span class="title {{ head_class }} px--1">Could not fetch TfL status</span>
{% if api_error %}<span class="{{ cell_class }} px--1">{{ api_error | escape }}</span>{% endif %}
{% else %}
{% assign disrupted = 0 %}
{%- for line in lines -%}
{%- assign line_disrupted = false -%}
{%- for status in line.lineStatuses -%}
{%- if status.statusSeverity != 10 and status.statusSeverity != 18 and status.statusSeverity != 20 -%}
{%- assign line_disrupted = true -%}
{%- endif -%}
{%- endfor -%}
{%- if line_disrupted -%}
{%- assign disrupted = disrupted | plus: 1 -%}
{%- endif -%}
{%- endfor -%}
{% if disrupted == 0 %}
<div class="flex flex--center-x flex--center-y stretch-y">
  <span class="value value--large">Good service on all lines</span>
</div>
{% elsif disrupted <= max_rows %}
{% capture rows %}
{% for line in lines %}
{%- assign best_rank = 1000 -%}
{%- assign best_status = nil -%}
{%- for status in line.lineStatuses -%}
{%- if status.statusSeverity != 10 and status.statusSeverity != 18 and status.statusSeverity != 20 -%}
{%- assign this_rank = 99 -%}
{%- assign sev_str = status.statusSeverity | append: "" -%}
{%- for code in severity_rank -%}
{%- if sev_str == code -%}{%- assign this_rank = forloop.index0 -%}{%- endif -%}
{%- endfor -%}
{%- if this_rank < best_rank -%}
{%- assign best_status = status -%}
{%- assign best_rank = this_rank -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{% if best_rank < 1000 %}
    <tr>
      {% if disrupted <= max_with_reason %}
      {%- comment -%}ponytail: drops everything before the first ": "; TfL always prefixes the line name{%- endcomment -%}
      {% assign reason_parts = best_status.reason | strip | split: ": " %}
      {% if reason_parts.size > 1 %}{% assign reason = reason_parts | slice: 1, 99 | join: ": " %}{% else %}{% assign reason = reason_parts | first %}{% endif %}
      <td class="pl--1"><span class="{{ cell_class }}">{{ line.name | escape }}</span><br><span class="label" data-clamp="2">{{ reason | escape }}</span></td>
      {% else %}
      <td class="pl--1"><span class="{{ cell_class }}">{{ line.name | escape }}</span></td>
      {% endif %}
      <td class="text--right pr--1"><span class="label label--inverted">{{ best_status.statusSeverityDescription | escape }}</span></td>
    </tr>
{% endif %}
{% endfor %}
{% endcapture %}
<div class="board">
<table class="table {{ table_class }}" data-table-limit="true">
  <thead>
    <tr>
      <th class="pl--1"><span class="title {{ head_class }}">Line</span></th>
      <th class="text--right pr--1"><span class="title {{ head_class }}">Status</span></th>
    </tr>
  </thead>
  <tbody>
{{ rows }}
  </tbody>
</table>
</div>
<span class="{{ cell_class }} px--1">Good service on all other lines</span>
{% else %}
<div class="board">
<div class="flex flex--wrap gap--small px--1">
  {%- for line in lines -%}
  {%- assign best_rank = 1000 -%}
  {%- assign best_status = nil -%}
  {%- for status in line.lineStatuses -%}
  {%- if status.statusSeverity != 10 and status.statusSeverity != 18 and status.statusSeverity != 20 -%}
  {%- assign this_rank = 99 -%}
  {%- assign sev_str = status.statusSeverity | append: "" -%}
  {%- for code in severity_rank -%}
  {%- if sev_str == code -%}{%- assign this_rank = forloop.index0 -%}{%- endif -%}
  {%- endfor -%}
  {%- if this_rank < best_rank -%}
  {%- assign best_status = status -%}
  {%- assign best_rank = this_rank -%}
  {%- endif -%}
  {%- endif -%}
  {%- endfor -%}
  {%- if best_rank < 1000 -%}
  {%- assign short_name = line.name | replace: "Hammersmith & City", "H&C" | replace: "Waterloo & City", "W&C" -%}
  <div class="flex gap--small flex--center-y"><span class="{{ cell_class }}">{{ short_name | escape }}</span><span class="label label--inverted">{{ best_status.statusSeverityDescription | escape }}</span></div>
  {%- endif -%}
  {%- endfor -%}
</div>
</div>
<span class="{{ cell_class }} px--1">Good service on all other lines</span>
{% endif %}
{% endif %}
{% endtemplate %}
