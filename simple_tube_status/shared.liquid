{% assign lines = data %}
{%- comment -%}ponytail: custom field values live under trmnl.plugin_settings.custom_fields_values, as "true"/"false" strings; accept a boolean too{%- endcomment -%}
{% assign show_disruptions = trmnl.plugin_settings.custom_fields_values.show_disruptions %}
{% assign show_reason = false %}{% if show_disruptions == true or show_disruptions == "true" %}{% assign show_reason = true %}{% endif %}
{% assign api_error = message | default: data.message %}
{% assign roundel = "data:image/svg+xml;base64," %}

{% template board %}
{%- comment -%}ponytail: severity_rank is our own worst-first order; a code missing from it sorts last{%- endcomment -%}
{%- assign severity_rank = "1,2,16,3,4,5,11,6,8,7,15,14,9,12,13,17,0,19" | split: "," -%}
{% assign n_lines = lines | size %}
{% if n_lines == 0 %}
<span class="title {{ head_class }} px--1">Could not fetch TfL status</span>
{% if api_error %}<span class="{{ cell_class }} px--1">{{ api_error | escape }}</span>{% endif %}
{% else %}
{% assign disrupted = 0 %}
{%- for line in lines -%}
{%- assign line_disrupted = false -%}
{%- for status in line.lineStatuses -%}
{%- if status.statusSeverity != 10 and status.statusSeverity != 18 and status.statusSeverity != 20 -%}
{%- assign line_disrupted = true -%}
{%- endif -%}
{%- endfor -%}
{%- if line_disrupted -%}
{%- assign disrupted = disrupted | plus: 1 -%}
{%- endif -%}
{%- endfor -%}
{% if disrupted == 0 %}
<div class="flex flex--center-x flex--center-y stretch-y">
  <span class="value value--large lg:value--xlarge lg:portrait:value--large">Good service on all lines</span>
</div>
{% else %}
{% capture rows %}
{% for line in lines %}
{%- assign best_rank = 1000 -%}
{%- assign best_status = nil -%}
{%- for status in line.lineStatuses -%}
{%- if status.statusSeverity != 10 and status.statusSeverity != 18 and status.statusSeverity != 20 -%}
{%- assign this_rank = 99 -%}
{%- assign sev_str = status.statusSeverity | append: "" -%}
{%- for code in severity_rank -%}
{%- if sev_str == code -%}{%- assign this_rank = forloop.index0 -%}{%- endif -%}
{%- endfor -%}
{%- if this_rank < best_rank -%}
{%- assign best_status = status -%}
{%- assign best_rank = this_rank -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{% if best_rank < 1000 %}
{%- comment -%}ponytail: Liquid cannot measure text, so a per-layout character budget stands in for width; names over it use the short form{%- endcomment -%}
{%- assign short_name = line.name | replace: "Hammersmith & City", "H&C" | replace: "Waterloo & City", "W&C" | replace: "Elizabeth line", "Elizabeth" | replace: "Metropolitan", "Met" -%}
{%- assign name_len = line.name | size -%}
{%- if name_len > max_name_chars -%}{%- assign show_name = short_name -%}{%- else -%}{%- assign show_name = line.name -%}{%- endif -%}
    <tr>
      {% if show_reason %}
      {%- comment -%}ponytail: drops everything before the first ": "; TfL always prefixes the line name{%- endcomment -%}
      {% assign reason_parts = best_status.reason | strip | split: ": " %}
      {% if reason_parts.size > 1 %}{% assign reason = reason_parts | slice: 1, 99 | join: ": " %}{% else %}{% assign reason = reason_parts | first %}{% endif %}
      <td class="pl--1"><span class="{{ cell_class }}">{{ show_name | escape }}</span><span class="label lg:label--xxlarge lg:portrait:label--large block" data-board="reason" data-clamp="1">{{ reason | escape }}</span></td>
      {% else %}
      <td class="pl--1"><span class="{{ cell_class }}">{{ show_name | escape }}</span></td>
      {% endif %}
      <td class="text--right pr--1" style="white-space:nowrap"><span class="{{ badge_class }}">{{ best_status.statusSeverityDescription | escape }}</span></td>
    </tr>
{% endif %}
{% endfor %}
{% endcapture %}
{% assign half = disrupted | plus: 1 | divided_by: 2 %}
{% assign seen = 0 %}
{% capture col1 %}{% endcapture %}
{% capture col2 %}{% endcapture %}
{%- for line in lines -%}
{%- assign best_rank = 1000 -%}
{%- assign best_status = nil -%}
{%- for status in line.lineStatuses -%}
{%- if status.statusSeverity != 10 and status.statusSeverity != 18 and status.statusSeverity != 20 -%}
{%- assign this_rank = 99 -%}
{%- assign sev_str = status.statusSeverity | append: "" -%}
{%- for code in severity_rank -%}
{%- if sev_str == code -%}{%- assign this_rank = forloop.index0 -%}{%- endif -%}
{%- endfor -%}
{%- if this_rank < best_rank -%}
{%- assign best_status = status -%}
{%- assign best_rank = this_rank -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- if best_rank < 1000 -%}
{%- assign short_name = line.name | replace: "Hammersmith & City", "H&C" | replace: "Waterloo & City", "W&C" | replace: "Elizabeth line", "Elizabeth" | replace: "Metropolitan", "Met" -%}
{%- capture row -%}<tr><td><span class="{{ col_class }}">{{ short_name | escape }}</span></td><td class="text--right" style="white-space:nowrap"><span class="{{ col_badge_class }}">{{ best_status.statusSeverityDescription | escape }}</span></td></tr>
{%- endcapture -%}
{%- assign seen = seen | plus: 1 -%}
{%- if seen <= half -%}
{%- assign col1 = col1 | append: row -%}
{%- else -%}
{%- assign col2 = col2 | append: row -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
<div class="grow w--full">
<div data-board="table">
<table class="table {{ table_class }}">
  <thead>
    <tr>
      <th class="pl--1"><span class="title {{ head_class }}">Line</span></th>
      <th class="text--right pr--1"><span class="title {{ head_class }}">Status</span></th>
    </tr>
  </thead>
  <tbody>
{{ rows }}
  </tbody>
</table>
</div>
<div class="hidden" data-board="columns">
<div class="columns">
  <div class="column">
    <table class="table {{ table_class }}"><tbody>
{{ col1 }}
    </tbody></table>
  </div>
  <div class="column">
    <table class="table {{ table_class }}"><tbody>
{{ col2 }}
    </tbody></table>
  </div>
</div>
</div>
</div>
<span class="{{ foot_class }} px--1" data-board="foot">Good service on all other lines</span>
{%- comment -%}ponytail: Liquid cannot measure, so the renderer's browser does. The table with reasons is the default; if the footer falls off the bottom of the layout the reasons are hidden, and if it still does the table gives way to the two-column block. Re-run whenever the layout is resized, because the editor applies the chosen device after load.{%- endcomment -%}
<script>
(function (layout) {
  function fit() {
    var foot = layout.querySelector("[data-board=foot]");
    var reasons = layout.querySelectorAll("[data-board=reason]");
    var table = layout.querySelector("[data-board=table]");
    var columns = layout.querySelector("[data-board=columns]");
    function overflows() { return foot.getBoundingClientRect().bottom > layout.getBoundingClientRect().bottom + 1; }
    reasons.forEach(function (r) { r.style.display = ""; });
    table.classList.remove("hidden");
    columns.classList.add("hidden");
    if (!overflows()) return;
    reasons.forEach(function (r) { r.style.display = "none"; });
    if (!overflows()) return;
    table.classList.add("hidden");
    columns.classList.remove("hidden");
  }
  document.fonts.ready.then(fit);
  new ResizeObserver(fit).observe(layout);
})(document.currentScript.closest(".layout"));
</script>
{% endif %}
{% endif %}
{% endtemplate %}
